+//! 标签页标题与工作区名的翻译（OTools 移植层补）。
+//!
+//! 上游 `ui.rs` 的词典只覆盖菜单与面板正文：`dock.rs` 里 `PanelKind::title()` 与
+//! `dock::WORKSPACES` 是**裸英文字符串**，中文界面下标签页仍是 `Info` / `Audio` /
+//! `Standard` 这类英文（上游桌面版同样如此）。这里按当前界面语言补一张小表，
+//! 只用于「显示」，`title()` 仍返回英文原文——`PanelKind::from_name` 和偏好里存的
+//! 工作区名都按英文匹配，不能动。
+//!
+//! 查不到就返回英文，所以没装表、语言不支持时零影响。
+
+use super::ui::current;
+
+/// 简体中文。
+const SIMPLIFIED: &[(&str, &str)] = &[
+    // 工作区（Window ▸ Workspace）
+    ("Default", "默认"),
+    ("Standard", "标准"),
+    ("Small Screen", "小屏幕"),
+    ("Animation", "动画"),
+    ("Effects", "效果"),
+    ("Motion Tracking", "运动跟踪"),
+    ("Paint", "绘画"),
+    ("Text", "文本"),
+    ("Minimal", "精简"),
+    ("All Panels", "所有面板"),
+    ("Review", "审阅"),
+    ("Learn", "学习"),
+    ("Essential Graphics", "基本图形"),
+    ("Color", "颜色"),
+    ("Undocked Panels", "浮动面板"),
+    // 面板标签页
+    ("Project", "项目"),
+    ("Effect Controls", "效果控件"),
+    ("Composition", "合成"),
+    ("Layer", "图层"),
+    ("Timeline", "时间轴"),
+    ("Info", "信息"),
+    ("Audio", "音频"),
+    ("Preview", "预览"),
+    ("Effects & Presets", "效果和预设"),
+    ("Properties", "属性"),
+    ("Character", "字符"),
+    ("Paragraph", "段落"),
+    ("Align", "对齐"),
+    ("Tracker", "跟踪器"),
+    ("Wiggler", "摆动器"),
+    ("Smoother", "平滑器"),
+    ("Motion Sketch", "运动草图"),
+    ("Brushes", "画笔"),
+    ("Render Queue", "渲染队列"),
+    ("Flowchart", "流程图"),
+    ("History", "历史记录"),
+    ("Markers", "标记"),
+    ("Mask Interpolation", "蒙版插值"),
+    ("Script Console", "脚本控制台"),
+    ("ScriptUI Panel", "ScriptUI 面板"),
+    ("Lumetri Scopes", "Lumetri 示波器"),
+    ("Footage", "素材"),
+    ("Media Browser", "媒体浏览器"),
+    ("Metadata", "元数据"),
+    ("Progress", "进度"),
+    ("Content-Aware Fill", "内容识别填充"),
+    ("Create Nulls From Paths", "从路径创建空对象"),
+    ("VR Comp Editor", "VR 合成编辑器"),
+];
+
+/// 繁体中文。
+const TRADITIONAL: &[(&str, &str)] = &[
+    ("Default", "預設"),
+    ("Standard", "標準"),
+    ("Small Screen", "小螢幕"),
+    ("Animation", "動畫"),
+    ("Effects", "效果"),
+    ("Motion Tracking", "運動追蹤"),
+    ("Paint", "繪畫"),
+    ("Text", "文字"),
+    ("Minimal", "精簡"),
+    ("All Panels", "所有面板"),
+    ("Review", "審閱"),
+    ("Learn", "學習"),
+    ("Essential Graphics", "基本圖形"),
+    ("Color", "顏色"),
+    ("Undocked Panels", "浮動面板"),
+    ("Project", "專案"),
+    ("Effect Controls", "效果控制項"),
+    ("Composition", "合成"),
+    ("Layer", "圖層"),
+    ("Timeline", "時間軸"),
+    ("Info", "資訊"),
+    ("Audio", "音訊"),
+    ("Preview", "預覽"),
+    ("Effects & Presets", "效果與預設"),
+    ("Properties", "屬性"),
+    ("Character", "字元"),
+    ("Paragraph", "段落"),
+    ("Align", "對齊"),
+    ("Tracker", "追蹤器"),
+    ("Wiggler", "擺動器"),
+    ("Smoother", "平滑器"),
+    ("Motion Sketch", "運動草圖"),
+    ("Brushes", "筆刷"),
+    ("Render Queue", "算圖佇列"),
+    ("Flowchart", "流程圖"),
+    ("History", "歷史記錄"),
+    ("Markers", "標記"),
+    ("Mask Interpolation", "遮罩插值"),
+    ("Script Console", "指令碼主控台"),
+    ("ScriptUI Panel", "ScriptUI 面板"),
+    ("Lumetri Scopes", "Lumetri 示波器"),
+    ("Footage", "素材"),
+    ("Media Browser", "媒體瀏覽器"),
+    ("Metadata", "中繼資料"),
+    ("Progress", "進度"),
+    ("Content-Aware Fill", "內容感知填色"),
+    ("Create Nulls From Paths", "從路徑建立空物件"),
+    ("VR Comp Editor", "VR 合成編輯器"),
+];
+
+/// 界面语言下 `en` 的显示名；没有译文时原样返回。
+pub(crate) fn panel_label(en: &'static str) -> &'static str {
+    find(en).unwrap_or(en)
+}
+
+/// 同 [`panel_label`]，但接受任意借用字符串（工作区列表里还有用户自建的名字）：有译文时返回译文，
+/// 否则把原样复制成 `String`。
+pub(crate) fn panel_label_owned(en: &str) -> String {
+    find(en).map_or_else(|| en.to_string(), str::to_string)
+}
+
+/// 当前语言的表里 `en` 对应的译文。
+fn find(en: &str) -> Option<&'static str> {
+    let table = match current() {
+        "zh-hans" => SIMPLIFIED,
+        "zh-hant" => TRADITIONAL,
+        _ => return None,
+    };
+    table.iter().find(|(key, _)| *key == en).map(|(_, translated)| *translated)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn both_catalogs_cover_the_same_labels() {
+        let mut hans: Vec<&str> = SIMPLIFIED.iter().map(|(k, _)| *k).collect();
+        let mut hant: Vec<&str> = TRADITIONAL.iter().map(|(k, _)| *k).collect();
+        hans.sort_unstable();
+        hant.sort_unstable();
+        assert_eq!(hans, hant, "简繁两张表必须覆盖同一批英文键");
+    }
+
+    #[test]
+    fn every_workspace_and_panel_has_a_label() {
+        for w in crate::dock::WORKSPACES {
+            assert!(SIMPLIFIED.iter().any(|(k, _)| k == w), "工作区缺少译文：{w}");
+        }
+        for p in crate::dock::PanelKind::ALL {
+            assert!(SIMPLIFIED.iter().any(|(k, _)| *k == p.title()), "面板缺少译文：{}", p.title());
+        }
+    }
+
+    #[test]
+    fn unknown_language_keeps_english() {
+        super::ui::set_current("en");
+        assert_eq!(panel_label("Info"), "Info");
+        super::ui::set_current("zh-hans");
+        assert_eq!(panel_label("Info"), "信息");
+        super::ui::set_current("en");
+    }
+}
